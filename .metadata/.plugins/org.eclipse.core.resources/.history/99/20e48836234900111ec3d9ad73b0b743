#include "ds3231.h"

static I2C_HandleTypeDef *ds3231_i2c = NULL;

uint8_t DS3231_DecToBCD(uint8_t value)
{
    return ((value / 10) << 4) | (value % 10);
}

uint8_t DS3231_BCDToDec(uint8_t value)
{
    return ((value >> 4) * 10) + (value & 0x0F);
}

DS3231_StatusTypeDef DS3231_Init(I2C_HandleTypeDef *hi2c)
{
    ds3231_i2c = hi2c;

    if (HAL_I2C_IsDeviceReady(ds3231_i2c,
                              DS3231_I2C_ADDRESS,
                              3,
                              100) == HAL_OK)
    {
        return DS3231_OK;
    }

    return DS3231_ERROR;
}

DS3231_StatusTypeDef DS3231_SetTime(DS3231_TimeTypeDef *time)
{
    uint8_t data[7];

    if (ds3231_i2c == NULL)
    {
        return DS3231_ERROR;
    }

    data[0] = DS3231_DecToBCD(time->seconds);
    data[1] = DS3231_DecToBCD(time->minutes);
    data[2] = DS3231_DecToBCD(time->hours);   // 24-hour mode
    data[3] = DS3231_DecToBCD(time->day);
    data[4] = DS3231_DecToBCD(time->date);
    data[5] = DS3231_DecToBCD(time->month);
    data[6] = DS3231_DecToBCD(time->year);

    if (HAL_I2C_Mem_Write(ds3231_i2c,
                          DS3231_I2C_ADDRESS,
                          DS3231_REG_SECONDS,
                          I2C_MEMADD_SIZE_8BIT,
                          data,
                          7,
                          100) == HAL_OK)
    {
        return DS3231_OK;
    }

    return DS3231_ERROR;
}

DS3231_StatusTypeDef DS3231_GetTime(DS3231_TimeTypeDef *time)
{
    uint8_t data[7];

    if (ds3231_i2c == NULL)
    {
        return DS3231_ERROR;
    }

    if (HAL_I2C_Mem_Read(ds3231_i2c,
                         DS3231_I2C_ADDRESS,
                         DS3231_REG_SECONDS,
                         I2C_MEMADD_SIZE_8BIT,
                         data,
                         7,
                         100) != HAL_OK)
    {
        return DS3231_ERROR;
    }

    time->seconds = DS3231_BCDToDec(data[0] & 0x7F);
    time->minutes = DS3231_BCDToDec(data[1] & 0x7F);
    time->hours   = DS3231_BCDToDec(data[2] & 0x3F);   // 24-hour format
    time->day     = DS3231_BCDToDec(data[3] & 0x07);
    time->date    = DS3231_BCDToDec(data[4] & 0x3F);
    time->month   = DS3231_BCDToDec(data[5] & 0x1F);
    time->year    = DS3231_BCDToDec(data[6]);

    return DS3231_OK;
}

DS3231_StatusTypeDef DS3231_SetDateTime(uint8_t sec,
                                         uint8_t min,
                                         uint8_t hour,
                                         uint8_t day,
                                         uint8_t date,
                                         uint8_t month,
                                         uint8_t year)
{
    DS3231_TimeTypeDef time;

    time.seconds = sec;
    time.minutes = min;
    time.hours   = hour;
    time.day     = day;
    time.date    = date;
    time.month   = month;
    time.year    = year;

    return DS3231_SetTime(&time);
}

DS3231_StatusTypeDef DS3231_GetTemperature(float *temperature)
{
    uint8_t data[2];
    int8_t temp_msb;
    uint8_t temp_lsb;

    if (ds3231_i2c == NULL)
    {
        return DS3231_ERROR;
    }

    if (HAL_I2C_Mem_Read(ds3231_i2c,
                         DS3231_I2C_ADDRESS,
                         DS3231_REG_TEMP_MSB,
                         I2C_MEMADD_SIZE_8BIT,
                         data,
                         2,
                         100) != HAL_OK)
    {
        return DS3231_ERROR;
    }

    temp_msb = (int8_t)data[0];
    temp_lsb = data[1] >> 6;

    *temperature = (float)temp_msb + ((float)temp_lsb * 0.25f);

    return DS3231_OK;
}
