/* USER CODE BEGIN 4 */

void HAL_UARTEx_RxEventCallback(UART_HandleTypeDef *huart, uint16_t Size)
{
    if (huart->Instance == USART1)
    {
        dma_rx_size = Size;
        dma_message_count++;
        dma_rx_flag = 1;

        memset((char *)rx_string, 0, DMA_RX_BUFFER_SIZE);

        for (uint16_t i = 0; i < Size && i < DMA_RX_BUFFER_SIZE - 1; i++)
        {
            if ((dma_rx_buffer[i] == '\r') || (dma_rx_buffer[i] == '\n'))
            {
                break;
            }

            rx_string[i] = (char)dma_rx_buffer[i];
        }

        memset(dma_rx_buffer, 0, DMA_RX_BUFFER_SIZE);

        uart_status = HAL_UARTEx_ReceiveToIdle_DMA(&huart1,
                                                   dma_rx_buffer,
                                                   DMA_RX_BUFFER_SIZE);

        __HAL_DMA_DISABLE_IT(huart1.hdmarx, DMA_IT_HT);
    }
}

void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1)
    {
        uart_error_flag = 1;

        uart_status = HAL_UARTEx_ReceiveToIdle_DMA(&huart1,
                                                   dma_rx_buffer,
                                                   DMA_RX_BUFFER_SIZE);

        __HAL_DMA_DISABLE_IT(huart1.hdmarx, DMA_IT_HT);
    }
}

